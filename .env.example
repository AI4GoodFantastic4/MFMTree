PROJECT_NAME=mfmtree
ENVIRONMENT=dev
AWS_REGION=eu-central-1
FRONTEND_ORIGIN=http://localhost:5173
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
ELEVENLABS_SECRET_NAME=mfmtree-dev/elevenlabs/api-key
ELEVENLABS_VOICE_NAME=Eric
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
TTS_ENABLED=true
# Local-only alternative for Lambda smoke tests. Do not commit real keys.
ELEVENLABS_API_KEY=

# Local Lambda smoke tests can use these values. AWS credentials are configured
# outside this repository through your shell, AWS profile, SSO, or CI.
RAW_DATA_BUCKET=
PROCESSED_DATA_BUCKET=
PROCESSED_BUCKET=
GEOMETRY_KEY=geometry/areas.geojson
INDICATORS_KEY=indicators/latest.json
LOCAL_GEOJSON_PATH=data/sample/areas.geojson
ALLOW_MOCK_DATA=true

# GIS processor defaults
RAW_BUCKET=
TARGET_REGION=ethiopia
OUTPUT_KEY=processed/scored_areas.json

# Google Earth Engine processor
GEE_AUTH_MODE=default
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
GEE_AOI_ASSET=
GEE_OUTPUT_BUCKET=
GEE_OUTPUT_PREFIX=reforestation/processed
GEE_START_DATE=2020-01-01
GEE_END_DATE=2025-12-31
GEE_EXPORT_SCALE=250
GEE_GRID_SIZE_M=10000
GEE_MAX_CONCURRENT_TASKS=3
GEE_DRY_RUN=true
